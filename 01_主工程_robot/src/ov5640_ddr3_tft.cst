IO_LOC  "uart_tx" M15;    // FPGA_UART_TX
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
//==== 任务四 PB：蓝牙人机通道（2026-10-12）====
//  P8 针1 USER_0 = 球号 H14（管脚表复用名 USB_PA3）← 蓝牙模块 TXD 【FPGA 输入】
//  P8 针2 USER_2 = 球号 H20（纯用户 IO，管脚表查不到）→ 蓝牙模块 RXD 【FPGA 输出】
//  ⛔ 上电前必做：空载量 H14/H15 对地电压 —— 悬空/漂(≈1~1.8V)=可用；
//     稳定 0V 或 3.3V = 板载 FX2 在驱动 ⇒ 改走 LED4~8 焊盘 K22 J22 H22 M21 N19
//  ⛔ 模块供电必须接 P8 的 VCC3V3（3.3V），绝不能接 VCC5V0
IO_LOC  "bt_rx" H14;    // P8 针1 USER_0
IO_PORT "bt_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;      // 输入脚：不能写 DRIVE（CT1108）
IO_LOC  "bt_tx" H20;    // P8 针2 USER_2
IO_PORT "bt_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

// ===== 任务四 P4：超声波（2026-10-17 引脚定案，P7 排针）=====
//  P7 第 34 针 = C20 = TRIG【输出】→ 模块 TRIG（3.3V 脉冲）
//  P7 第 38 针 = E18 = ECHO【输入】← 模块 ECHO（⚠️ 5V 电平，经 HW221/TXS0108E 降到 3.3V）
//  ★注意：P7-35/E19 是右后编码器 B 相（enc_b[3]），绝不能用做 TRIG
IO_LOC  "ultra_trig" C20;
IO_PORT "ultra_trig" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "ultra_echo" E18;
IO_PORT "ultra_echo" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;   // 输入脚：不能写 DRIVE（CT1108）

//==== 任务四 P3.5：电池电压监测（板载 ADC128S102，2026-10-14）====
//  原理图第 15 页 15_ADDA.SchDoc：U43 = ADC128S102CIMT（8 通道 12bit SPI，Vref=3.3V）
//  引脚来自官方《ACG720-138&60K通用管脚分配表》ADC 段（第 41~44 行），全部 LVCMOS33
//  ⚠️ 输入脚不可写 DRIVE（会 ERROR CT1108，物理约束解析直接失败）
IO_LOC  "adc_cs_n" M6;      // → U43.1  CS_N（低有效片选）
IO_PORT "adc_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "adc_din"  M5;      // → U43.14 DIN（通道控制字，FPGA 输出）
IO_PORT "adc_din"  IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "adc_sclk" N5;      // → U43.16 SCLK
IO_PORT "adc_sclk" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "adc_dout" P6;      // ← U43.15 DOUT（转换结果，FPGA 输入）
IO_PORT "adc_dout" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
