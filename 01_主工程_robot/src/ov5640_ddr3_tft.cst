// ---- T14：MPU6050 I2C（走 P7 空闲 GPIO0 脚，不用板载 I2C——板上无对外排针）----
// P7 逐针表：第31脚 = GPIO0_26 = F16、第32脚 = GPIO0_27 = E17（官方管脚分配表 L226/227）
IO_LOC "IIC_SCL" F16;
IO_PORT "IIC_SCL" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "IIC_SDA" D20;    // 2026-10-10 换脚：E17(P7-32) 实测损坏(空片态 1.3V)，改用 D20(P7-33)
IO_PORT "IIC_SDA" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

// ============================================================================
//  任务二「运动控制」引脚 —— 2026-10-12 整合
//  来源：组长已在实物上验证的 ACG720_task2_ir.cst（下面每行原样搬过来）
//  ⚠️ 车上驱动板的线就是按这张表接的 ⇒ 不要改这里，否则车不动
//  ⚠️ 已损坏、绝不要用的 7 个脚：A13 A18 F13 E14 D14 D15 E17
// ============================================================================
IO_LOC  "key[0]" F15;   // S0
IO_PORT "key[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "key[1]" A20;   // S1
IO_PORT "key[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "key[2]" B20;   // S2
IO_PORT "key[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "key[3]" A21;   // S3
IO_PORT "key[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "ir_in" F21;    // 板上红外接收头输出（空闲高，收到 38kHz 载波时低）
IO_PORT "ir_in" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "m_in1[0]" D16;   // GPIO0_21  通道A AIN1   M1 左前   ★改脚（原 A13）
IO_PORT "m_in1[0]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8;
IO_LOC  "m_in1[1]" A14;   // GPIO0_1   通道B BIN1   M2 右前
IO_PORT "m_in1[1]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8;
IO_LOC  "m_in1[2]" A15;   // GPIO0_2   通道C CIN1   M3 左后
IO_PORT "m_in1[2]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8;
IO_LOC  "m_in1[3]" A16;   // GPIO0_3   通道D DIN1   M4 右后
IO_PORT "m_in1[3]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8;
IO_LOC  "m_in2[0]" B17;   // GPIO0_22  通道A AIN2   M1 左前   ★改脚（原 A18）
IO_PORT "m_in2[0]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8;
IO_LOC  "m_in2[1]" A19;   // GPIO0_5   通道B BIN2   M2 右前
IO_PORT "m_in2[1]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8;
IO_LOC  "m_in2[2]" B18;   // GPIO0_23  通道C CIN2   M3 左后   ★改脚（原 F13）
IO_PORT "m_in2[2]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8;
IO_LOC  "m_in2[3]" F14;   // GPIO0_7   通道D DIN2   M4 右后
IO_PORT "m_in2[3]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8;
IO_LOC  "m_pwm[0]" E13;   // GPIO0_8   通道A PWMA   M1 左前
IO_PORT "m_pwm[0]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8;
IO_LOC  "m_pwm[1]" C18;   // GPIO0_24  通道B PWMB   M2 右前   ★改脚（原 E14）
IO_PORT "m_pwm[1]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8;
IO_LOC  "m_pwm[2]" C13;   // GPIO0_10  通道C PWMC   M3 左后
IO_PORT "m_pwm[2]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8;
IO_LOC  "m_pwm[3]" B13;   // GPIO0_11  通道D PWMD   M4 右后
IO_PORT "m_pwm[3]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8;
IO_LOC  "stdby" C19;      // GPIO0_25   ★改脚（原 D14）
IO_PORT "stdby" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8;
IO_LOC  "enc_a[0]" D19;   // GPIO0_31  通道A E1A   M1   ★改脚（原 D15）
IO_PORT "enc_a[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "enc_a[1]" C14;   // GPIO0_14  通道B E2A   M2
IO_PORT "enc_a[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
